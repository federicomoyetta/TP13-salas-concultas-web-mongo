< class="detalle">
  <p class="etiqueta">Reservas de salas</p>
  <h2>Reserva #<%= reserva.id %></h2>

  <dl>
    <dt><strong>Estudiante</strong></dt>
    <dd><%= reserva.estudiante %></dd>

    <dt><strong>Email</strong></dt>
    <dd><%= reserva.email %></dd>

    <dt><strong>Sala</strong></dt>
    <dd><%= reserva.sala %></dd>

    <dt><strong>Fecha</strong></dt>
    <dd><%= reserva.fecha %></dd>

    <dt><strong>Turno</strong></dt>
    <dd><%= reserva.turno %></dd>

    <dt><strong>Cantidad de personas</strong></dt>
    <dd><%= reserva.personas %></dd>

    <dt><strong>Estado</strong></dt>
    <dd><%= reserva.estado %></dd>
  </dl>

   <div class="acciones-detalle">
    <a class="boton" href="/reservas/<%= reserva.id %>/editar">
      Editar reserva
    </a>
    <a class="boton" href="/reservas/<%= reserva.id %>/estado">
      Cambiar estado
    </a>
    <a class="boton" href="/reservas/<%= reserva.id %>/eliminar">
      Eliminar reserva
    </a>
    <a class="boton" href="/reservas">Volver al listado</a>
    <a class="boton" href="/reservas/nueva">Nueva reserva</a>
  </div>
</section>
