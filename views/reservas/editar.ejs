
<section class="panel-formulario">
  <p class="etiqueta">EDICIÓN</p>
  <h1><%= titulo %></h1>

  <% if (error) { %>
    <p class="error" role="alert"><%= error %></p>
  <% } %>

  <form
    action="/reservas/<%= id %>/editar"
    method="post"
    class="formulario"
  >
    <label for="estudiante">Estudiante</label>
    <input
      id="estudiante"
      name="estudiante"
      type="text"
      value="<%= valores.estudiante %>"
      required
    >

    <label for="email">Email</label>
    <input
      id="email"
      name="email"
      type="email"
      value="<%= valores.email %>"
      required
    >

    <label for="sala">Sala</label>
    <select id="sala" name="sala" required>
      <option value="">Elegí una sala</option>
      <% for (const sala of salasPermitidas) { %>
        <option
          value="<%= sala %>"
          <%= valores.sala === sala ? "selected" : "" %>
        >
          <%= sala %>
        </option>
      <% } %>
    </select>

    <label for="fecha">Fecha</label>
    <input
      id="fecha"
      name="fecha"
      type="date"
      value="<%= valores.fecha %>"
      required
    >

    <label for="turno">Turno</label>
    <select id="turno" name="turno" required>
      <option value="">Elegí un turno</option>
      <% for (const turno of turnosPermitidos) { %>
        <option
          value="<%= turno %>"
          <%= valores.turno === turno ? "selected" : "" %>
        >
          <%= turno %>
        </option>
      <% } %>
    </select>

    <label for="personas">Personas</label>
    <input
      id="personas"
      name="personas"
      type="number"
      min="1"
      max="6"
      step="1"
      value="<%= valores.personas %>"
      required
    >

    <label for="estado">Estado</label>
    <select id="estado" name="estado" required>
      <option value="">Elegí un estado</option>
      <option
        value="pendiente"
        <%= valores.estado === "pendiente" ? "selected" : "" %>
      >
        Pendiente
      </option>
      <option
        value="confirmada"
        <%= valores.estado === "confirmada" ? "selected" : "" %>
      >
        Confirmada
      </option>
    </select>

    <button type="submit">Guardar cambios</button>

    <a href="/reservas/<%= id %>">
      Cancelar y volver al detalle
    </a>
  </form>
</section>
