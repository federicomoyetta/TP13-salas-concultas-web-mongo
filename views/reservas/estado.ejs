
<section class="panel-formulario">
  <p class="etiqueta">CAMBIO DE ESTADO</p>
  <h1><%= titulo %></h1>

  <p>Se modificará únicamente el estado de la reserva.
    Los demás datos se conservarán.</p>

  <% if (error) { %>
    <p class="error" role="alert"><%= error %></p>
  <% } %>

  <form
    action="/reservas/<%= id %>/estado"
    method="post"
    class="formulario"
  >
    <label for="estado">Estado</label>
    <select id="estado" name="estado" required>
      <option value="">Elegí un estado</option>
      <option
        value="pendiente"
        <%= valores.estado === "pendiente" ? "selected" : "" %>
      >
        Pendiente
      </option>
      <option
        value="confirmada"
        <%= valores.estado === "confirmada" ? "selected" : "" %>
      >
        Confirmada
      </option>
    </select>

    <button type="submit">Guardar estado</button>

    <a href="/reservas/<%= id %>">
      Cancelar y volver al detalle
    </a>
  </form>
</section>
